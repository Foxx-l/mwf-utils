# MWF Faction Bot — Environment example

# ── Required ───────────────────────────────────────────────────────────
BOT_TOKEN=your_bot_token
CLIENT_ID=your_client_id
GUILD_ID=your_guild_id

# ── Faction ─────────────────────────────────────────────────────────────
FACTION_CHANNEL=faction_channel_id
ALLIES_ROLE=allies_s1_role_id
AXIS_ROLE=axis_s1_role_id
ALLIES_S2_ROLE=allies_s2_role_id
AXIS_S2_ROLE=axis_s2_role_id

# ── Logging ─────────────────────────────────────────────────────────────
ADMIN_LOG_CHANNEL=admin_log_channel_id

# ── Lineup ──────────────────────────────────────────────────────────────
LINEUP_CHANNEL=lineup_channel_id
LINEUP_COMMAND_CHANNEL=channel_id_where_lineup_command_is_allowed

# ── Server Details ──────────────────────────────────────────────────────
SERVER_DETAILS_CHANNEL=server_details_channel_id
# Per-server defaults (used by Post Server S1 / Post Server S2 buttons)
SERVER_S1_NAME=HCIA EU 1
SERVER_S1_PASSWORD=MWFTIME
SERVER_S2_NAME=HCIA EU 2
SERVER_S2_PASSWORD=MWFTIME
# Legacy single-server fallback (used when SERVER_S{1,2}_* are unset)
SERVER_NAME=HCIA EU 1
SERVER_PASSWORD=MWFTIME

# ── Nodes ──────────────────────────────────────────────────────────────
NODES_CHANNELS=channel_id_1,channel_id_2

# ── Map Rotation ───────────────────────────────────────────────────────
MAP_ROTATION_CHANNEL=map_rotation_channel_id
# Default event time in Europe/Warsaw (24-hour HH:MM)
ROTATION_EVENT_TIME=20:00

# ── Team Rep Automation ─────────────────────────────────────────────────
# Channel where users request Team Rep role (post any message to request role)
TEAM_REP_CHANNEL=team_rep_request_channel_id
# Role to assign when a request is approved
TEAM_REP_ROLE_ID=team_rep_role_id
# Role that gets pinged on every new request (e.g. your Admins/Officers role)
TEAM_REP_PING_ROLE=role_id_to_ping_on_new_requests
# Optional: cooldown in milliseconds per user to avoid spam (default 60000)
# TEAM_REP_COOLDOWN_MS=60000
# Optional: maximum retry attempts for transient failures (default 3)
# TEAM_REP_MAX_RETRIES=3
# Optional: base backoff in milliseconds used for exponential backoff (default 500)
# TEAM_REP_BACKOFF_BASE_MS=500

# ── Per-clan RaidHelper signups (optional feature) ──────────────────────
# API key from the RaidHelper bot — run /apikey in your Discord server.
# Leaving it unset disables the whole signups feature (panel row, scheduler).
# RAIDHELPER_API_KEY=your_raidhelper_api_key
# RaidHelper's bot user ID in your guild, so the private clan channels can
# grant it access (right-click the RaidHelper bot → Copy User ID).
# RAIDHELPER_BOT_ID=raidhelper_bot_user_id
# RaidHelper template for the clan and solo events (default ct21, the guild's
# custom Solo Signup template; clan events suppress its temp_role). Custom
# guild templates use the ct prefix — plain numbers are RaidHelper's built-ins.
# RAIDHELPER_TEMPLATE_ID=ct21
# RAIDHELPER_SOLO_TEMPLATE_ID=ct21
# Leader shown on the created events (default: this bot itself). RaidHelper
# DMs the leader once per created event, so a human id here means one DM per clan.
# SIGNUP_LEADER_ID=discord_user_id
# Category the signup channels live under (created if missing)
# SIGNUP_CATEGORY_NAME=MWF Signups
# Match weekday 0=Sun…6=Sat (default 3 = Wednesday) and auto-post lead time in days
# SIGNUP_MATCH_DAY=3
# SIGNUP_LEAD_DAYS=7

# ── Auto-reset schedule (default: Wednesday at 22:00 Warsaw) ─────────────
# RESET_DAY=3   (0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat)
# RESET_HOUR=22

# ── Anti-spam: cooldown between faction swaps per user (seconds, default 20)
# FACTION_SWAP_COOLDOWN_SECONDS=20

# ── Max faction swaps processed in parallel (default 5). Queues the rest.
# FACTION_SWAP_CONCURRENCY=5

# ── Cooldown between destructive admin actions per user (seconds, default 10)
# ADMIN_DESTRUCTIVE_COOLDOWN_SECONDS=10

# ── Guild allowlist (optional). When set, bot only responds in listed guilds.
# ALLOWED_GUILDS=guild_id_1,guild_id_2

# ── Local data storage (optional) ─────────────────────────────────────────
# Defaults to ./data relative to the bot's working directory.
# Docker automatically uses /app/data because its working directory is /app.
# DATA_DIR=C:\Users\your-name\mwf-utils\data

# ── Debug (optional) ─────────────────────────────────────────────────────
# LOG_LEVEL=debug
